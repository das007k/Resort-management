# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://stayaxis:CHANGE_ME@localhost:5432/stayaxis_dev?schema=public"

# --- Auth -----------------------------------------------------------------
# Long random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="CHANGE_ME"
AUTH_SESSION_COOKIE_NAME="stayaxis_session"
# Session lifetime in seconds (default 12h)
AUTH_SESSION_TTL_SECONDS=43200

# --- App environment --------------------------------------------------------
# development | staging | production
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"

# --- Providers (sandbox/mock by default — see providers/*) ----------------
PAYMENT_PROVIDER="mock"           # mock | razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

CHANNEL_MANAGER_PROVIDER="mock"

WHATSAPP_PROVIDER="mock"
WHATSAPP_API_TOKEN=""

# --- Object storage (future) ------------------------------------------------
STORAGE_PROVIDER="local"
